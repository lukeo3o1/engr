{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-record.local/schemas/state-v1.schema.json",
  "title": "Engineering Record State v1",
  "description": "Protocol-v1 materialized Work Item and Decision Record State documents.",
  "oneOf": [
    { "$ref": "#/$defs/workItemState" },
    { "$ref": "#/$defs/decisionState" }
  ],
  "$defs": {
    "eventId": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "entityId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{0,63}$"
    },
    "workItemId": {
      "type": "string",
      "pattern": "^WI-[0-9]{8}-[0-9]{2}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^DR-[0-9]{8}-[0-9]{2}-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "artifactReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "confirmation": {
      "type": "object",
      "required": ["challenge"],
      "properties": {
        "challenge": {
          "type": "string",
          "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["initiator", "basis", "confirmation"],
          "properties": {
            "initiator": { "const": "human" },
            "basis": { "const": "human_confirmation" },
            "confirmation": { "$ref": "#/$defs/confirmation" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["initiator", "basis"],
          "properties": {
            "initiator": { "const": "agent" },
            "basis": {
              "enum": [
                "observation",
                "inference",
                "agent_proposal",
                "implementation",
                "verification",
                "dependency_change"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["initiator", "basis"],
          "properties": {
            "initiator": { "const": "system" },
            "basis": {
              "enum": ["observation", "verification", "dependency_change"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "head": {
      "type": "object",
      "required": ["event_id", "rev"],
      "properties": {
        "event_id": { "$ref": "#/$defs/eventId" },
        "rev": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "simpleRecord": {
      "type": "object",
      "required": ["text", "event_id", "provenance"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "event_id": { "$ref": "#/$defs/eventId" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "basicEntry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text",
        "introduced_by",
        "last_event_id",
        "last_text",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "status": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "currentEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "const": "active" } } }
      ]
    },
    "factEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["active", "invalidated"] } } }
      ]
    },
    "constraintEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["active", "removed"] } } }
      ]
    },
    "unknownEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["unresolved", "resolved"] } } }
      ]
    },
    "hypothesisEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["active", "invalidated"] } } }
      ]
    },
    "riskEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["open", "accepted", "mitigated"] } } }
      ]
    },
    "blockerEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "enum": ["active", "cleared"] } } }
      ]
    },
    "solutionEntry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text",
        "introduced_by",
        "last_event_id",
        "last_text",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "status": { "enum": ["proposed", "selected", "rejected", "superseded"] },
        "text": { "type": "string", "minLength": 1 },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "superseded_by": {
          "anyOf": [
            { "$ref": "#/$defs/entityId" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "superseded" } } },
          "then": { "required": ["superseded_by"] },
          "else": { "not": { "required": ["superseded_by"] } }
        }
      ]
    },
    "implementationEntry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text",
        "introduced_by",
        "last_event_id",
        "last_text",
        "provenance",
        "solution_id",
        "artifacts"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "status": { "enum": ["in_progress", "completed", "superseded"] },
        "text": { "type": "string", "minLength": 1 },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "solution_id": {
          "anyOf": [
            { "$ref": "#/$defs/entityId" },
            { "type": "null" }
          ]
        },
        "artifacts": { "$ref": "#/$defs/artifactReferences" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "in_progress" } } },
          "then": { "properties": { "artifacts": { "maxItems": 0 } } }
        }
      ]
    },
    "verificationEntry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text",
        "introduced_by",
        "last_event_id",
        "last_text",
        "provenance",
        "required",
        "result",
        "artifacts"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "status": { "enum": ["pending", "passed", "failed", "inconclusive"] },
        "text": { "type": "string", "minLength": 1 },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "required": { "type": "boolean" },
        "result": {
          "enum": [null, "passed", "failed", "inconclusive"]
        },
        "artifacts": { "$ref": "#/$defs/artifactReferences" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": { "const": "pending" },
            "result": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "passed" },
            "result": { "const": "passed" }
          }
        },
        {
          "properties": {
            "status": { "const": "failed" },
            "result": { "const": "failed" }
          }
        },
        {
          "properties": {
            "status": { "const": "inconclusive" },
            "result": { "const": "inconclusive" }
          }
        }
      ]
    },
    "findingEntry": {
      "type": "object",
      "required": [
        "id",
        "status",
        "text",
        "introduced_by",
        "last_event_id",
        "last_text",
        "provenance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "status": { "enum": ["active", "promoted"] },
        "text": { "type": "string", "minLength": 1 },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" },
        "work_item_id": { "$ref": "#/$defs/workItemId" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "promoted" } } },
          "then": { "required": ["work_item_id"] },
          "else": { "not": { "required": ["work_item_id"] } }
        }
      ]
    },
    "decisionLink": {
      "type": "object",
      "required": ["decision_id", "status", "introduced_by", "last_event_id", "last_text", "provenance"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/decisionId" },
        "status": { "enum": ["linked", "unlinked"] },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "workItemRelation": {
      "type": "object",
      "required": [
        "work_item_id",
        "relation",
        "introduced_by",
        "status",
        "last_event_id",
        "last_text",
        "provenance"
      ],
      "properties": {
        "work_item_id": { "$ref": "#/$defs/workItemId" },
        "relation": {
          "enum": ["relates_to", "depends_on", "blocks", "duplicates", "parent_of"]
        },
        "introduced_by": { "$ref": "#/$defs/eventId" },
        "status": { "enum": ["active", "removed"] },
        "last_event_id": { "$ref": "#/$defs/eventId" },
        "last_text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "additionalProperties": false
    },
    "retiredEntry": {
      "allOf": [
        { "$ref": "#/$defs/basicEntry" },
        { "properties": { "status": { "const": "superseded" } } }
      ]
    },
    "retired": {
      "type": "object",
      "required": ["problems", "impacts"],
      "properties": {
        "problems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/retiredEntry" }
        },
        "impacts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/retiredEntry" }
        }
      },
      "additionalProperties": false
    },
    "workItemState": {
      "type": "object",
      "required": [
        "format",
        "protocol_version",
        "event_schema_version",
        "state_schema_version",
        "stream",
        "kind",
        "status",
        "head",
        "title",
        "problem",
        "impact",
        "retired",
        "facts",
        "constraints",
        "unknowns",
        "hypotheses",
        "solutions",
        "selected_solution",
        "implementations",
        "verification",
        "findings",
        "risks",
        "blockers",
        "decisions",
        "related_work_items",
        "integrity"
      ],
      "properties": {
        "format": { "const": "engineering-eventstore-state" },
        "protocol_version": { "const": 1 },
        "event_schema_version": { "const": 1 },
        "state_schema_version": { "const": 1 },
        "stream": { "$ref": "#/$defs/workItemId" },
        "kind": { "const": "work_item" },
        "status": {
          "enum": [
            "discovered",
            "clarifying",
            "investigating",
            "solution_ready",
            "implementing",
            "verifying",
            "blocked",
            "reopened",
            "deferred",
            "resolved",
            "cancelled"
          ]
        },
        "head": { "$ref": "#/$defs/head" },
        "title": { "$ref": "#/$defs/simpleRecord" },
        "problem": {
          "anyOf": [
            { "$ref": "#/$defs/currentEntry" },
            { "type": "null" }
          ]
        },
        "impact": {
          "anyOf": [
            { "$ref": "#/$defs/currentEntry" },
            { "type": "null" }
          ]
        },
        "retired": { "$ref": "#/$defs/retired" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/factEntry" }
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraintEntry" }
        },
        "unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/unknownEntry" }
        },
        "hypotheses": {
          "type": "array",
          "items": { "$ref": "#/$defs/hypothesisEntry" }
        },
        "solutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/solutionEntry" }
        },
        "selected_solution": {
          "anyOf": [
            { "$ref": "#/$defs/entityId" },
            { "type": "null" }
          ]
        },
        "implementations": {
          "type": "array",
          "items": { "$ref": "#/$defs/implementationEntry" }
        },
        "verification": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationEntry" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingEntry" }
        },
        "risks": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskEntry" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blockerEntry" }
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionLink" }
        },
        "related_work_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/workItemRelation" }
        },
        "integrity": { "$ref": "#/$defs/integrity" }
      },
      "additionalProperties": false
    },
    "decisionState": {
      "type": "object",
      "required": [
        "format",
        "protocol_version",
        "event_schema_version",
        "state_schema_version",
        "stream",
        "kind",
        "status",
        "head",
        "topic",
        "decision",
        "superseded_by",
        "integrity"
      ],
      "properties": {
        "format": { "const": "engineering-eventstore-state" },
        "protocol_version": { "const": 1 },
        "event_schema_version": { "const": 1 },
        "state_schema_version": { "const": 1 },
        "stream": { "$ref": "#/$defs/decisionId" },
        "kind": { "const": "decision" },
        "status": { "enum": ["proposed", "accepted", "superseded", "revoked"] },
        "head": { "$ref": "#/$defs/head" },
        "topic": { "$ref": "#/$defs/simpleRecord" },
        "decision": {
          "anyOf": [
            { "$ref": "#/$defs/simpleRecord" },
            { "type": "null" }
          ]
        },
        "superseded_by": {
          "anyOf": [
            { "$ref": "#/$defs/decisionId" },
            { "type": "null" }
          ]
        },
        "integrity": { "$ref": "#/$defs/integrity" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": { "const": "proposed" },
            "decision": { "type": "null" },
            "superseded_by": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "accepted" },
            "decision": { "$ref": "#/$defs/simpleRecord" },
            "superseded_by": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "superseded" },
            "decision": { "$ref": "#/$defs/simpleRecord" },
            "superseded_by": { "$ref": "#/$defs/decisionId" }
          }
        },
        {
          "properties": {
            "status": { "const": "revoked" },
            "decision": { "$ref": "#/$defs/simpleRecord" },
            "superseded_by": { "type": "null" }
          }
        }
      ]
    }
  }
}
